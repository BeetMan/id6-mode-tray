<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ID6ModeTray</AssemblyName>
    <RootNamespace>ID6ModeTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\id6-mode.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="M2Mqtt.Net">
      <HintPath>lib\M2Mqtt.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\id6-mode-icon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
